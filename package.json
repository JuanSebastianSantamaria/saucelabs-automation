{
  "name": "saucelabs-automation",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "WebdriverIO and TypeScript API/UI automation framework",
  "scripts": {
    "test": "npm run test:api && npm run test:ui",
    "test:api": "tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json",
    "test:ui": "wdio run ./wdio.conf.ts --suite ui",
    "report": "allure generate allure-results --clean --output allure-report && allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.30",
    "@wdio/allure-reporter": "^9.19.2",
    "@wdio/cli": "^9.19.2",
    "@wdio/globals": "^9.19.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "allure-commandline": "^2.34.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "mocha": "^11.7.1",
    "mochawesome": "^8.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "webdriverio": "^9.19.2"
  }
}
